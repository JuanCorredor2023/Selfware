# Copy to /etc/selfware/selfware.env (chmod 600, owned by the service user).
NEBIUS_API_KEY=
SELFWARE_AGENT=real
# One index folder (e.g. the Enron "folders" or "nano" index from scripts/index_enron.py).
SELFWARE_CHROMA_PATH=/srv/selfware/data/chroma_index
SELFWARE_CACHE_DIR=/srv/selfware/data/cache
