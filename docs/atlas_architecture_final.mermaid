flowchart LR
    subgraph SRC["Sources"]
        GM[Gmail]
        WU[WhoareU.md]
    end

    subgraph ING["ingest/ · Person 1"]
        CONN[Gmail connector]
        NORM[Normalize + dedup]
        CLS["Classify PARA<br/>Nemotron NANO"]
        ARCH["Automatic archiving<br/>(job)"]
    end

    subgraph CTX["context/ · Person 2"]
        STORE[(Document store)]
        EMB[Embeddings]
        IDXF[(Flat index)]
        IDXP[(Index + PARA filter)]
        RET["retrieve(query, strategy, k)<br/>→ chunks + provenance"]
    end

    subgraph AGT["agent/ · Person 3"]
        ANS["Answering agent<br/>Nemotron ULTRA"]
        CONF[Confidence per answer]
        ABS{"confidence<br/>< threshold?"}
        TAV[Tavily web]
    end

    subgraph EVL["eval/ · Person 3"]
        QS[~200 questions<br/>labeled by category]
        RAG[RAGAS]
        REP[Report by category<br/>flat vs PARA]
    end

    subgraph WEB["api/ + web/ · Person 4"]
        API[FastAPI]
        DASH[React Dashboard]
        TOG[Flat vs PARA toggle]
        PROV[Visible provenance]
        COST[Cost panel by tier]
    end

    subgraph OBS["observability/ · Person 4, everyone instruments"]
        LLM["core/llm.py<br/>single exit point to Token Factory"]
        OT[OpenTelemetry<br/>tier · tokens · latency · cost]
    end

    GM --> CONN --> NORM --> CLS --> STORE
    WU --> ANS
    STORE --> EMB --> IDXF
    EMB --> IDXP
    IDXF --> RET
    IDXP --> RET
    STORE -.-> ARCH -.-> STORE
    RET --> ANS --> CONF --> ABS
    ABS -- yes --> TAV --> ANS
    ABS -- no --> API
    RET --> QS
    ANS --> QS
    QS --> RAG --> REP
    API --> DASH
    DASH --- TOG
    DASH --- PROV
    DASH --- COST
    CLS -.-> LLM
    ANS -.-> LLM
    LLM --> OT --> COST
    OT --> REP

    JOBS["Nebius Serverless Jobs<br/>ingestion · archiving · eval runs"]
    JOBS -.runs.-> ING
    JOBS -.runs.-> EVL
