flowchart LR
    subgraph SRC["Fuentes"]
        GM[Gmail]
        WU[WhoareU.md]
    end

    subgraph ING["ingest/ · Persona 1"]
        CONN[Conector Gmail]
        NORM[Normalizar + dedup]
        CLS["Clasificar PARA<br/>Nemotron NANO"]
        ARCH["Archivo automático<br/>(job)"]
    end

    subgraph CTX["context/ · Persona 2"]
        STORE[(Document store)]
        EMB[Embeddings]
        IDXF[(Índice plano)]
        IDXP[(Índice + filtro PARA)]
        RET["retrieve(query, strategy, k)<br/>→ chunks + procedencia"]
    end

    subgraph AGT["agent/ · Persona 3"]
        ANS["Agente de respuesta<br/>Nemotron ULTRA"]
        CONF[Confianza por respuesta]
        ABS{"confianza<br/>< umbral?"}
        TAV[Tavily web]
    end

    subgraph EVL["eval/ · Persona 3"]
        QS[~200 preguntas<br/>etiquetadas por categoría]
        RAG[RAGAS]
        REP[Reporte por categoría<br/>plano vs PARA]
    end

    subgraph WEB["api/ + web/ · Persona 4"]
        API[FastAPI]
        DASH[Dashboard React]
        TOG[Toggle plano vs PARA]
        PROV[Procedencia visible]
        COST[Panel de costo por escalón]
    end

    subgraph OBS["observability/ · Persona 4, todos instrumentan"]
        LLM["core/llm.py<br/>único punto de salida a Token Factory"]
        OT[OpenTelemetry<br/>tier · tokens · latencia · costo]
    end

    GM --> CONN --> NORM --> CLS --> STORE
    WU --> ANS
    STORE --> EMB --> IDXF
    EMB --> IDXP
    IDXF --> RET
    IDXP --> RET
    STORE -.-> ARCH -.-> STORE
    RET --> ANS --> CONF --> ABS
    ABS -- sí --> TAV --> ANS
    ABS -- no --> API
    RET --> QS
    ANS --> QS
    QS --> RAG --> REP
    API --> DASH
    DASH --- TOG
    DASH --- PROV
    DASH --- COST
    CLS -.-> LLM
    ANS -.-> LLM
    LLM --> OT --> COST
    OT --> REP

    JOBS["Nebius Serverless Jobs<br/>ingesta · archivo · corridas de eval"]
    JOBS -.ejecuta.-> ING
    JOBS -.ejecuta.-> EVL
